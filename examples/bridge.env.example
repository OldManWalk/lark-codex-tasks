# lark-codex-tasks 配置示例 —— 复制为 ~/.config/lark-codex-tasks/bridge.env（chmod 600）
# install.sh init 会交互式生成；本文件是全量参考。

# ── 必填 ──
# 你的飞书 open_id（ou_ 开头）：唯一可以指挥机器人的人，所有消息/卡片回调都校验它
LARK_OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 飞书侧 ──
# 运维兜底群 chat_id（oc_ 开头）：审批丢失上下文时的兜底投递；留空则兜底投递跳过
LARK_OPS_CHAT=
# 审批卡片上显示的操作人名字
LARK_OWNER_NAME=owner

# ── 品牌与路径 ──
LCT_BRAND=lark-codex-tasks
LCT_SERVICE_NAME=lark-codex-tasks
#LCT_STATE_DIR=$HOME/.local/state/lark-codex-tasks
#LCT_CONFIG_DIR=$HOME/.config/lark-codex-tasks
#LCT_WORKSPACE_ROOT=$HOME/workspace
#LCT_ARCHIVE_DIR=$HOME/workspace/knowledge/content/任务归档
#LCT_THREAD_PREFIX=lct

# ── 私聊人格（可选）──
# 人格文件：整段 Markdown 注入私聊线程（见 examples/persona.example.md）
#LCT_PERSONA_FILE=$HOME/.config/lark-codex-tasks/persona.md
# 称呼（如：老板）；私聊在线回执；私聊受理回执
#LCT_DM_ADDRESS=
#LCT_DM_GREETING=
#LCT_DM_ACK=

# ── 私聊沙箱路径（非默认安装位置时设置）──
#LCT_NODE_BIN=$HOME/.local/bin/node
#LCT_CODEX_PKG=$HOME/.local/lib/node_modules/@openai/codex

# ── 调优（一般不动）──
#LCT_OB_MAX_ATTEMPTS=5        # 出站消息投递重试次数
#LCT_OB_BACKOFF_MS=2000       # 出站消息投递退避基数
